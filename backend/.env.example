# Copy to .env. Run supabase/schema.sql in the Supabase SQL editor before starting the API.
PORT=3001
FRONTEND_URL=http://localhost:5173

# Google OAuth client (Web). Redirect URI must match the value registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Server-only Supabase key (secret / service_role). The browser never sees this.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
